<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="personDao" class="ru.otus.spring.dao.PersonDaoSimple" />

    <bean id="personService" class="ru.otus.spring.service.PersonServiceImpl">
        <constructor-arg index="0" ref="personDao"/>
    </bean>
    <bean id="questionDao" class="ru.otus.spring.dao.QuestionDaoImpl">
        <constructor-arg value="questions.csv"/>
    </bean>
    <bean id="testOutputService" class="ru.otus.spring.service.TestOutputServiceImpl">
        <constructor-arg ref="questionDao"/>
    </bean>

</beans>
